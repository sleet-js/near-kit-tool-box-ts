{
  "name": "@near-kit-tool-box/web",
  "description": "Browser-specific NEAR KIT client setup with Hot Wallet Connect",
  "version": "0.2.1",
  "homepage": "https://sleet-js.near.page",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/near-kit-tool-box-ts.git",
    "directory": "packages/web"
  },
  "scripts": {
    "build": "rm -f .tsbuildinfo && bun run tsc --build --force",
    "clean": "bun run tsc --build --clean && rm -rf dist .tsbuildinfo"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "near-kit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
